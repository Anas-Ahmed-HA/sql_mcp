// Template for appsettings.Local.json, the machine's own settings file: copy it next to the binary (or here, for
// local development), rename it to appsettings.Local.json and fill it in. The real file is gitignored and never
// published, so a deploy neither ships nor overwrites it. This example file itself is never read.
{
  // Server only: the host name agents use in the URL. Leave it out on a development machine.
  "AllowedHosts": "<host name, e.g. sqlmcp.internal>",

  // Server only: an absolute folder the IIS app pool account can write to. Leave it out on a development machine
  // to write to "logs" next to the binary.
  "Query": { "AuditDirectory": "D:\\Logs\\ai-sql-mcp" },

  "Database": {
    // One entry per database. The name is what agents pass as 'database' and the metadata file name
    // (metadata/<name>.md). Give each a read-only login (sql/01_create_readonly_principal.sql).
    "ConnectionStrings": {
      "Apps_InformationTechnology": "Server=<server>;Database=Apps_InformationTechnology;UID=<login>;PWD=<password>;TrustServerCertificate=True;"
    }
  }
}
