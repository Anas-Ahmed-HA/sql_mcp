{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "ModelContextProtocol": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Query": {
    "DefaultRows": 100,
    "MaxRows": 1000,
    "MaxCellLength": 1000,
    "AuditDirectory": "logs"
  },
  "RateLimit": {
    "RequestsPerMinute": 120
  },
  "Urls": "http://localhost:5100",
  "Database": {
    "ConnectionStrings": {
      "Apps_InformationTechnology": ""
    },
    "CommandTimeoutSeconds": 30,
    "CatalogCacheMinutes": 10
  }
}
