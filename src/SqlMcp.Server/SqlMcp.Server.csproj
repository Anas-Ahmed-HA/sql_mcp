<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>SqlMcp.Server</RootNamespace>
    <UserSecretsId>ai-sql-mcp-server</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="Microsoft.SqlServer.TransactSql.ScriptDom" Version="180.140.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Holds this machine's password. A server keeps its own copy, which a deploy must neither ship nor overwrite. -->
    <Content Update="appsettings.Local.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <!-- Business-rules files live at the repo root and are copied next to the binary, where the server reads them. -->
    <None Include="..\..\metadata\**\*.md" LinkBase="metadata" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
